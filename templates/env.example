# BiteCampus environment variables — TEMPLATE ONLY (placeholders, no real values).
# Compare with your existing .env and add only the names you are missing.
# Never commit a real .env file.

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database (local)
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/bitecampus_dev?schema=public

# Google sign-in (OAuth client ID from Google Cloud Console; not a secret, but keep it in env)
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
# Comma-separated allowed email domains (Q-01 — confirm the exact value)
ALLOWED_EMAIL_DOMAINS=<college-domain>

# Secrets — generate cryptographically random values with Node (works in any PowerShell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#   TERMINAL_SECRET_KEY needs exactly 32 bytes:  ...randomBytes(32)...
SESSION_SECRET=<random-64-chars>
TERMINAL_SECRET_KEY=<random-base64-32-bytes>

# Feature switches
DEMO_MODE=true
BIOMETRIC_SIMULATOR_ENABLED=true
AUTH_DEV_STUB=false

# Tunables (working defaults from docs/OPEN_DECISIONS.md)
AUTO_BOOKING_HORIZON_DAYS=2
AUTO_BOOKING_CRON=0 * * * *
QR_CHALLENGE_TTL_SECONDS=30
QR_ROTATE_SECONDS=15
GATE_TIMEOUT_MS=3000

LOG_LEVEL=info
